# Local Emscripten SDK checkout (cloned by setup, never committed)
.emsdk/

# CMake build directories
build/
core/build/
wasm/build/

# Node / web tooling
web/node_modules/
web/dist/
web/tsconfig.tsbuildinfo

# Generated Emscripten glue output — regenerated by scripts/build_wasm.ps1,
# not checked in. Lives under web/src/ (not web/public/) so Vite's dev
# server can serve it through the normal ES module pipeline. Keep the
# directory itself (see web/src/wasm-gen/.gitkeep).
web/src/wasm-gen/*.wasm
web/src/wasm-gen/*.js
web/src/wasm-gen/*.wasm.map

# OS / editor cruft
.DS_Store
Thumbs.db

# Local dev server logs
*.log
